{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/agent-kit.conf)",
      "Edit(/_docs/specs.md)",
      "Edit(/_docs/agent-kit/**)",
      "Edit(/.claude/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/_docs/agent-kit/claude-code/hooks/guard_git.py"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "Generated with Claude Code",
    "pr": "",
    "sessionUrl": false
  }
}
