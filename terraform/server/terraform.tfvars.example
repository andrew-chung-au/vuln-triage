# Copy to terraform.tfvars (git-ignored). Defaults suit the submission; override
# as needed.
aws_region           = "ap-southeast-2"
instance_type        = "t3.medium" # VERIFY sizing; t3.small is the fallback
data_volume_gb       = 30
nightly_stop_enabled = true
nightly_stop_cron    = "cron(0 14 * * ? *)" # 14:00 UTC; adjust to your timezone

secret_names = ["vuln-triage/dev", "vuln-triage/prod"] # names only; values created by the human

# Leave empty until task 37; then set the verified SES sender identity ARN.
ses_sender_identity_arn = ""
