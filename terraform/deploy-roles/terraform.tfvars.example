# Copy to terraform.tfvars (git-ignored). Set create_oidc_provider from the
# account check in aws-setup.md step 7.3.
aws_region   = "ap-southeast-2"
github_owner = "andrew-chung-au"
github_repo  = "vuln-triage"

# true  -> no GitHub OIDC provider exists in the account; create it.
# false -> one exists; reuse it and set existing_oidc_provider_arn below.
create_oidc_provider       = false
existing_oidc_provider_arn = "arn:aws:iam::ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"
