# Copy this file to a git-ignored .env and fill in the values before starting
# the Compose stack (issue #137, task 15). Names only; no real values are
# committed. The stub switches have their submission default shown.
#
# This lists only what the submission needs as a whole. Future-development settings
# (the backend LLM key, MCP_API_TOKEN, N8N_API_TOKEN, tracker tokens and SMTP
# credentials) are not here; they do not exist for submission.

# Postgres password for the `db` service (and the backend's DATABASE_URL).
POSTGRES_PASSWORD=

# Read-only GitHub token the backend uses to read dependency files.
GITHUB_READ_TOKEN=

# Bearer token for the responder's read-only API (US-15).
RESPONDER_API_TOKEN=

# Grafana admin password (used by the observability stack, task 24).
GRAFANA_ADMIN_PASSWORD=

# Owner-notification mail route (task 37). MAIL_TRANSPORT selects `memory` (the
# in-process sink `make test` uses; the default when unset), `mailhog` (the
# Compose stack and local dev) or `ses` (AWS); the Compose stack sets
# `mailhog` for the backend in its own environment. MAIL_SENDER is the one
# verified sender address every message is sent from; a send from any other
# address is refused and nothing is delivered. MAIL_SMTP_HOST / MAIL_SMTP_PORT
# are the MailHog target and default to the `mailhog` service on 1025 when
# unset. Leave these empty here (no committed values); set them in .env.
MAIL_TRANSPORT=
MAIL_SENDER=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=

# The responder agent's LLM key (used by the responder, task 28).
RESPONDER_LLM_KEY=

# Stub-mode switches. Keep these as `stub` for the submission stack; they keep
# the LLM and responder from making real calls.
LLM_MODE=stub
RESPONDER_MODE=stub

# The model the real responder names (F4). Only read when RESPONDER_MODE=real,
# and then it is REQUIRED (there is no default in code), so unset refuses to
# start. Used only for the owner's recorded drill (task 39) on a host that is
# not the clean clone, together with ANTHROPIC_API_KEY in the real .env (never
# committed). Stub mode ignores it. Pinned by owner decision F4: set it to
# claude-sonnet-5-5 in your real .env (this file carries no values).
RESPONDER_MODEL=

# Real-mode run limits (#241). Only read when RESPONDER_MODE=real; empty means the
# default. No secret in any of them.
# Consecutive failed runs for one alert before it is no longer retried (default 3);
# a resolved notification lifts the cap.
RESPONDER_MAX_FAILED_RUNS=
# Real agent runs in flight at once in one process (default 1).
RESPONDER_MAX_CONCURRENT_RUNS=
# Accepted alerts allowed to wait behind the running ones (default 10); beyond that
# an alert is refused with a 503 and its claim released, so Grafana's retry runs it.
RESPONDER_MAX_QUEUED_RUNS=
# Spend cap for one agent run in US dollars, passed to the SDK as max_budget_usd
# (default 3.0). A run that reaches it ends as an error.
RESPONDER_MAX_BUDGET_USD=

# Feed source (task 40). Leave empty for the default `live`, which matches and
# enriches against the real OSV/CISA KEV/FIRST EPSS/GitHub feeds. Set
# VT_FEEDS=fixtures (in .env, not here) to replay the committed
# tests/fixtures/{osv,kev,epss,github} with no network, for the Compose
# telemetry/alert/responder jobs. An unknown value stops start-up. Fixtures mode
# is refused unless DEPLOYMENT_ENVIRONMENT is explicitly dev or test (fail
# closed: unset/prod refuse), so it can never run in production.
VT_FEEDS=

# Deployment environment: `dev`, `test` or `prod` (set in .env). Sets the
# telemetry deployment.environment label AND gates the VT_FEEDS=fixtures /
# VT_DEMO_DEFECT refusals (both refused unless this is explicitly dev/test). The
# prod deploy MUST set this to `prod` (task 18); leaving it unset counts as
# production for the safety checks (fail closed).
DEPLOYMENT_ENVIRONMENT=