{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "AGENTS.md": "ask",
      "agent-kit.conf": "ask",
      "_docs/specs.md": "ask",
      "_docs/agent-kit/*": "ask",
      "opencode.json": "ask",
      ".opencode/*": "ask"
    },
    "bash": {
      "*": "ask",
      "make *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add .": "deny",
      "git add -A*": "deny",
      "git add --all*": "deny",
      "git add -u*": "deny",
      "git commit -a*": "deny",
      "git commit --all*": "deny",
      "*--no-verify*": "deny",
      "git push*": "deny",
      "git config core.hooksPath*": "deny"
    }
  }
}
