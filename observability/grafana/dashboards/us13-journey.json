{
  "uid": "us13-journey",
  "title": "US-13 journey",
  "tags": ["vulntriage", "us-13"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Notifications (metric) — vt_notifications_total, running total",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vt_notification_kind, vt_outcome) (vt_notifications_total)",
          "legendFormat": "{{vt_notification_kind}}/{{vt_outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Journey traces (Tempo) — scan.run",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name = \"scan.run\" }"
        }
      ]
    },
    {
      "id": 3,
      "title": "Journey logs (Loki) — backend events",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"vulntriage-backend\"}"
        }
      ]
    }
  ]
}
