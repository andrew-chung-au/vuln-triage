{
  "uid": "us13-journey",
  "title": "US-13 journey",
  "tags": ["vulntriage", "us-13"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(deployment_environment)",
        "includeAll": true,
        "multi": false,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(service_version)",
        "includeAll": true,
        "multi": false,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Notifications (metric) — vt_notifications_total",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vt_notification_kind, vt_outcome) (rate(vt_notifications_total[5m]))",
          "legendFormat": "{{vt_notification_kind}}/{{vt_outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Journey traces (Tempo) — scan.run",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name = \"scan.run\" }"
        }
      ]
    },
    {
      "id": 3,
      "title": "Journey logs (Loki) — backend events",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"vulntriage-backend\"}"
        }
      ]
    }
  ]
}
