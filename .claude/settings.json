{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git cat-file -p *)",
      "Bash(git cat-file -t *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(sha256sum *)"
    ],
    "ask": [
      "Bash(make issue-close*)",
      "Bash(make *issue-close*)",
      "Bash(gh issue create *)",
      "Bash(gh api *)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/Makefile)",
      "Edit(/agent-kit.conf)",
      "Edit(/_docs/specs.md)",
      "Edit(/_docs/project-brief.md)",
      "Edit(/_docs/agent-kit/**)",
      "Edit(/opencode.json)",
      "Edit(/.opencode/**)",
      "Edit(/.claude/**)",
      "Edit(/.devcontainer/**)",
      "Edit(/.githooks/**)",
      "Edit(/.github/**)",
      "Edit(/.vscode/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Bash(git push * main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(gh issue delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/_docs/agent-kit/claude-code/hooks/guard_git.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/_docs/agent-kit/claude-code/hooks/cloud_session_start.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "AGENT_KIT_CLOUD_PUSH": "1"
  },
  "attribution": {
    "commit": "AI-assisted",
    "pr": "",
    "sessionUrl": false
  }
}
