{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode//deepseek-v4.1-flash-free",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "AGENTS.md": "ask",
      "Makefile": "ask",
      "agent-kit.conf": "ask",
      "_docs/specs.md": "ask",
      "_docs/project-brief.md": "ask",
      "_docs/agent-kit/*": "ask",
      "opencode.json": "ask",
      ".opencode/*": "ask",
      "CLAUDE.md": "ask",
      ".claude/*": "ask"
    },
    "bash": {
      "*": "ask",
      "make *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git branch -vv*": "allow",
      "git branch --show-current*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh issue comment*": "allow",
      "gh issue close*": "ask",
      "gh issue create*": "allow",
      "gh issue edit*": "ask",
      "gh issue delete*": "deny",
      "gh api*": "ask",
      "grep *": "allow",
      "ls*": "allow",
      "echo *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git add .": "deny",
      "git add -A*": "deny",
      "git add --all*": "deny",
      "git add -u*": "deny",
      "git commit -a*": "deny",
      "git commit --all*": "deny",
      "*--no-verify*": "deny",
      "git push*": "deny",
      "git config core.hooksPath*": "deny",
      "wc *": "allow",
      "gh repo view*": "allow",
      "jq *": "allow",
      "* > *": "ask",
      "* >> *": "ask",
      "*.env*": "deny",
      "*.env.example*": "allow"
    }
  }
}
