{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "AGENTS.md": "ask",
      "CLAUDE.md": "ask",
      "Makefile": "ask",
      "agent-kit.conf": "ask",
      "opencode.json": "ask",
      "_docs/specs.md": "ask",
      "_docs/project-brief.md": "ask",
      "_docs/agent-kit/**": "ask",
      ".opencode/**": "ask",
      ".claude/**": "ask"
    },
    "bash": {
      "*": "ask",

      "make *": "allow",
      "make issue-close*": "ask",
      "make *issue-close*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git ls-files*": "allow",
      "git blame*": "allow",
      "git describe*": "allow",
      "git fetch*": "allow",
      "git branch -vv": "allow",
      "git branch --show-current": "allow",
      "git config --get*": "allow",
      "git worktree list*": "allow",
      "git remote -v": "allow",
      "git remote show *": "allow",
      "git cat-file -p*": "allow",
      "git cat-file -t*": "allow",
      "sha256sum *": "allow",

      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh issue comment*": "allow",
      "gh issue close*": "ask",
      "gh issue edit*": "ask",
      "gh issue delete*": "deny",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh run watch*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh label list*": "allow",
      "gh repo view*": "allow",
      "gh api*": "ask",

      "command -v *": "allow",
      "id": "allow",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "jq *": "allow",
      "rg *": "allow",
      "echo *": "allow",
      "pgrep *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "date*": "allow",
      "realpath *": "allow",
      "basename *": "allow",
      "dirname *": "allow",

      "git add *": "allow",
      "git commit *": "allow",
      "git add .": "deny",
      "git add -A*": "deny",
      "git add --all*": "deny",
      "git add -u*": "deny",
      "git commit -a*": "deny",
      "git commit --all*": "deny",
      "*--no-verify*": "deny",
      "git push*": "deny",
      "git config core.hooksPath*": "deny",

      "* > *": "ask",
      "* >> *": "ask",

      "*.env*": "deny",
      "*.env.example*": "allow"
    }
  }
}