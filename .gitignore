# Agent kit ignore rules: keep these four lines first and in this order,
# so .env.example stays tracked.
.env
.env.*
!.env.example
.scratch/

# Live OpenCode permission-prompt log (written by .opencode/plugins/permission-log.js).
# Not in .scratch/ because `make clean-scratch` empties that. Snapshots for review are
# committed under _docs/permission-sweeps/ at each sweep.
.agent-logs/*
!.agent-logs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
*.log

# Local databases
*.db
*.sqlite
*.sqlite3

# Editor and OS files
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Terraform (task 17 / #141): never commit state, local dirs or real tfvars.
# Only *.tf, *.tfvars.example and the module READMEs are tracked.
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl
