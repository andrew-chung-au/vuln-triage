# Agent kit ignore rules: keep these four lines first and in this order,
# so .env.example stays tracked.
.env
.env.*
!.env.example
.scratch/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
*.log

# Local databases
*.db
*.sqlite
*.sqlite3

# Editor and OS files
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
